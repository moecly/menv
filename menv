#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_DIR="${MOECLY_DIR:-$HOME/.moecly_conf}"

REPOS=(
    "tmux:https://github.com/moecly/tmux-config.git"
    "zsh:https://github.com/moecly/zsh-config.git"
    "nvim:https://github.com/moecly/nvim-config.git"
)

TOOLS=(
    "git:git"
    "lazygit:lazygit"
    "fd:fd fdfind"
    "rg:rg"
    "fzf:fzf"
    "zsh:zsh"
    "nvim:nvim"
    "tmux:tmux"
    "npm:npm"
    "unzip:unzip"
    "python3:python3"
    "pip3:pip3"
)

check_base_dir() {
    if [[ ! -d "$BASE_DIR" ]]; then
        mkdir -p "$BASE_DIR"
    fi
}

cmd_init() {
    check_base_dir
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        url="${item#*:}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path" ]]; then
            echo "[$name] already exists, skip"
        else
            echo "Cloning $url..."
            git clone "$url" "$repo_path"
        fi
    done
}

cmd_pull() {
    echo "=== Updating menv ==="
    if [[ -d "$SCRIPT_DIR/.git" ]]; then
        git -C "$SCRIPT_DIR" pull
    else
        echo "menv is not a git repository, skip"
    fi

    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            echo "=== Pulling $name ==="
            git -C "$repo_path" pull
        fi
    done
}

cmd_list() {
    echo "Repositories in $BASE_DIR:"
    echo "--------------------------"
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            status="cloned"
        else
            status="not cloned"
        fi
        printf "%-10s %s\n" "$name" "$status"
    done
}

cmd_doctor() {
    echo "Checking tools..."
    for tool in "${TOOLS[@]}"; do
        name="${tool%%:*}"
        cmds="${tool#*:}"
        found=0
        for cmd in $cmds; do
            if command -v "$cmd" >/dev/null 2>&1; then
                found=1
                break
            fi
        done
        if [[ $found -eq 1 ]]; then
            printf "✓ %-8s found\n" "$name"
        else
            printf "✗ %-8s not found\n" "$name"
        fi
    done
}

cmd_link() {
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        link_script="$BASE_DIR/$name/link.sh"
        if [[ -x "$link_script" ]]; then
            echo "=== Linking $name ==="
            "$link_script"
        else
            echo "[$name] link.sh not found or not executable, skip"
        fi
    done
}

show_help() {
    cat <<EOF
Usage: menv <command>

Commands:
    init    Clone all repositories
    pull   Pull all repositories (including menv itself)
    list   List all repositories
    link   Execute link.sh in all repositories
    doctor Check required tools
    help   Show this help

Examples:
    menv init
    menv pull
    menv list
    menv link
    menv doctor
EOF
}

main() {
    cmd="$1"
    shift || true
    case "$cmd" in
        init)    cmd_init ;;
        pull)   cmd_pull ;;
        list)   cmd_list ;;
        link)   cmd_link ;;
        doctor) cmd_doctor ;;
        help|--help|-h) show_help ;;
        "")
            show_help
            ;;
        *)
            echo "Unknown command: $cmd"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
