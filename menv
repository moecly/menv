#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_DIR="${MOECLY_DIR:-$HOME/.moecly_conf}"

convert_url() {
    local url="$1"
    local protocol="$2"
    if [[ "$protocol" == "ssh" ]]; then
        echo "$url" | sed 's|https://github.com/|git@github.com:|g'
    else
        echo "$url" | sed 's|git@github.com:|https://github.com/|g'
    fi
}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

div() {
    printf "${CYAN}%s${NC}\n" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

get_max_name_length() {
    local max_len=0
    for item in "$@"; do
        name="${item%%:*}"
        len=${#name}
        ((len > max_len)) && max_len=$len
    done
    echo $max_len
}

