#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_DIR="${MOECLY_DIR:-$HOME/.moecly_conf}"

# Load configuration
for conf in "$SCRIPT_DIR"/config/*.conf; do
    source "$conf"
done

# ============================================================
# Colors & Helpers
# ============================================================

source "$SCRIPT_DIR/sh/common.sh"

div() {
    printf "${CYAN}%s${NC}\n" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

progressbar() {
    local current="$1" total="$2" width="${3:-20}"
    local filled=$(( current * width / total ))
    local empty=$(( width - filled ))
    local bar=""
    for ((i = 0; i < filled; i++)); do bar+="█"; done
    for ((i = 0; i < empty; i++)); do bar+="░"; done
    echo "$bar"
}

get_category_label() {
    local alias="$1"
    for entry in "${CATEGORY_ALIASES[@]}"; do
        IFS=: read -r a label <<< "$entry"
        if [[ "$a" == "$alias" ]]; then
            echo "$label"
            return
        fi
    done
    echo "$alias"
}

get_category_order() {
    local -A seen
    for tool in "${TOOLS[@]}"; do
        parse_tool_entry "$tool"
        if [[ -z "${seen[$TOOL_CATEGORY]}" ]]; then
            seen[$TOOL_CATEGORY]=1
            echo "$TOOL_CATEGORY"
        fi
    done
}

get_max_name_length() {
    local max_len=0
    for item in "$@"; do
        parse_tool_entry "$item"
        len=${#TOOL_NAME}
        ((len > max_len)) && max_len=$len
    done
    echo $max_len
}

convert_url() {
    local url="$1"
    local protocol="$2"

    # GitHub HTTPS → SSH
    if [[ "$protocol" == "ssh" && "$url" =~ ^https://github\.com/(.*)$ ]]; then
        local path="${BASH_REMATCH[1]}"
        echo "git@github.com:$path"
    # GitHub SSH → HTTPS
    elif [[ "$protocol" == "https" && "$url" =~ ^git@github\.com:(.*)$ ]]; then
        local path="${BASH_REMATCH[1]}"
        echo "https://github.com/$path"
    # 其他情况返回原 URL
    else
        echo "$url"
    fi
}

PACMAN_CACHE=""

build_pacman_cache() {
    if command -v pacman >/dev/null 2>&1; then
        PACMAN_CACHE=$(pacman -Q 2>/dev/null | awk '{print $1}')
    fi
}

check_installed() {
    local pkg_mgr="$1"
    local name="$2"
    local cmds="$3"
    local container="${4:-root}"
    local export_mode="${5:-cli}"

    if [[ -n "$pkg_mgr" && -n "$PACMAN_CACHE" ]]; then
        if echo "$PACMAN_CACHE" | grep -q "^${name}$"; then
            return 0
        fi
    fi

    if [[ -n "$cmds" ]]; then
        for cmd in $cmds; do
            if command -v "$cmd" >/dev/null 2>&1; then
                return 0
            fi
        done
    fi

    if [[ "$container" != "root" && "$export_mode" == "none" ]]; then
        if check_distrobox_available && container_exists "$container"; then
            local first_cmd="${cmds%% *}"
            if [[ -n "$first_cmd" ]] && dbx_exec "$container" which "$first_cmd" >/dev/null 2>&1; then
                return 0
            fi
        fi
    fi

    return 1
}

# ============================================================
# Distrobox Helpers
# ============================================================

parse_tool_entry() {
    local line="$1"
    TOOL_SOURCE_FIELD=""
    TOOL_SOURCE=""
    TOOL_CONTAINER=""
    TOOL_PKG_MGR=""
    TOOL_EXPORT=""
    TOOL_CATEGORY=""
    TOOL_TYPE=""
    TOOL_NAME=""
    TOOL_CMDS=""
    TOOL_DESC=""

    # Format: target:pkg_mgr:export:category:type:package:commands:description
    IFS=: read -r TOOL_CONTAINER TOOL_PKG_MGR TOOL_EXPORT TOOL_CATEGORY TOOL_TYPE TOOL_NAME TOOL_CMDS TOOL_DESC <<< "$line"

    if [[ "$TOOL_CONTAINER" == "root" ]]; then
        TOOL_SOURCE="$TOOL_PKG_MGR"
        TOOL_SOURCE_FIELD="$TOOL_PKG_MGR"
    else
        TOOL_SOURCE="distrobox"
        TOOL_SOURCE_FIELD="distrobox:${TOOL_CONTAINER}:${TOOL_PKG_MGR}:${TOOL_EXPORT}"
    fi
}

check_distrobox_available() {
    command -v distrobox >/dev/null 2>&1
}

get_container_config() {
    local name="$1"
    for entry in "${DISTROBOX_CONTAINERS[@]}"; do
        IFS=: read -r cname image home_dir <<< "$entry"
        if [[ "$cname" == "$name" ]]; then
            echo "$image:$home_dir"
            return 0
        fi
    done
    return 1
}

container_exists() {
    local name="$1"
    distrobox-list 2>/dev/null | awk '{print $3}' | grep -q "^${name}$"
}

ensure_container() {
    local name="$1"
    if container_exists "$name"; then
        return 0
    fi
    local config
    config=$(get_container_config "$name") || {
        echo -e "${RED}Error: No image defined for container '$name'${NC}"
        return 1
    }
    local image="${config%%:*}"
    local home_dir="${config#*:}"

    if [[ -z "$home_dir" ]]; then
        home_dir="$BASE_DIR/distrobox/$name"
    fi

    echo -e "${CYAN}Creating distrobox container:${NC} $name ($image) home=$home_dir"
    distrobox-create --name "$name" --image "$image" --home "$home_dir" --yes
}

dbx_exec() {
    local container="$1"
    shift
    distrobox-enter --name "$container" -- "$@"
}

dbx_install_packages() {
    local container="$1"
    local pkg_mgr="$2"
    shift 2
    local pkgs=("$@")

    if [[ ${#pkgs[@]} -eq 0 ]]; then
        return
    fi

    echo -e "${BOLD}Installing in container ${CYAN}$container${NC} via ${pkg_mgr}: ${GREEN}${pkgs[*]}${NC}"
    case "$pkg_mgr" in
        pacman) dbx_exec "$container" sudo pacman -S --needed --noconfirm "${pkgs[@]}" ;;
        aur)    dbx_exec "$container" paru -S --needed --noconfirm "${pkgs[@]}" ;;
        dnf)    dbx_exec "$container" sudo dnf install -y "${pkgs[@]}" ;;
        apt)    dbx_exec "$container" sudo apt-get install -y "${pkgs[@]}" ;;
        snap)   dbx_exec "$container" sudo snap install "${pkgs[@]}" ;;
        *)      echo -e "${RED}Error: Unknown package manager '$pkg_mgr'${NC}" ;;
    esac
}

is_from_host() {
    local cmds="$1"
    local dbx_export_path="${DISTROBOX_EXPORT_PATH:-$BASE_DIR/distrobox_bin}"
    for cmd in $cmds; do
        local path
        path=$(command -v "$cmd" 2>/dev/null) || continue
        if [[ "$path" != "${dbx_export_path}/"* ]]; then
            return 0
        fi
    done
    return 1
}

dbx_export_bin() {
    local container="$1"
    local binary_path="$2"
    local export_path="${DISTROBOX_EXPORT_PATH:-$BASE_DIR/distrobox_bin}"

    mkdir -p "$export_path"
    distrobox-export --container "$container" --bin "$binary_path" --export-path "$export_path"
}

dbx_export_app() {
    local container="$1"
    local app_name="$2"
    distrobox-export --container "$container" --app "$app_name"
}

do_dbx_export() {
    local container="$1"
    local package="$2"
    local cmds="$3"
    local export_mode="$4"

    if [[ "$export_mode" == "none" ]]; then
        return 0
    fi

    if [[ "$export_mode" == "app" ]]; then
        dbx_export_app "$container" "$package"
        return
    fi

    local first_cmd="${cmds%% *}"
    if [[ -n "$first_cmd" ]]; then
        local bin_path
        bin_path=$(dbx_exec "$container" which "$first_cmd" 2>/dev/null)
        if [[ -n "$bin_path" ]]; then
            dbx_export_bin "$container" "$bin_path"
        fi
    fi
}

# ============================================================
# Commands
# ============================================================

check_base_dir() {
    if [[ ! -d "$BASE_DIR" ]]; then
        mkdir -p "$BASE_DIR"
    fi
}

cmd_init() {
    check_base_dir
    echo
    echo -e "${BOLD}Initializing repositories...${NC}"
    div
    local cloned=0 skipped=0 failed=0
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        url="${item#*:}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path" ]]; then
            echo -e "  ${YELLOW}⊝${NC}  $name"
            skipped=$((skipped + 1))
        else
            echo -n -e "  ${GREEN}⬢${NC}  Cloning $name... "
            if git clone "$url" "$repo_path" 2>/dev/null; then
                echo -e "${GREEN}done${NC}"
                cloned=$((cloned + 1))
            else
                echo -e "${RED}failed${NC}"
                failed=$((failed + 1))
            fi
        fi
    done
    div
    echo -e "  ${BOLD}Summary:${NC} ${GREEN}✓ ${cloned} cloned${NC}, ${YELLOW}⊝ ${skipped} skipped${NC}${failed:+, ${RED}✗ ${failed} failed${NC}}"
    div
}

cmd_pull() {
    echo
    div
    echo -e "${BOLD}  ⬇  Updating menv${NC}"
    if [[ -d "$SCRIPT_DIR/.git" ]]; then
        git -C "$SCRIPT_DIR" pull
    else
        echo -e "  ${YELLOW}⊝${NC}  menv is not a git repository"
    fi
    div

    local tmpdir
    tmpdir=$(mktemp -d)
    local pids=()

    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        [[ -d "$repo_path/.git" ]] || continue

        (
            output=$(git -C "$repo_path" pull 2>&1)
            rc=$?
            if [[ $rc -ne 0 ]]; then
                echo "$name:failed" > "$tmpdir/$name"
            elif echo "$output" | grep -q "Already up to date"; then
                echo "$name:uptodate" > "$tmpdir/$name"
            else
                echo "$name:updated" > "$tmpdir/$name"
            fi
        ) &
        pids+=($!)
    done

    for pid in "${pids[@]}"; do wait "$pid"; done

    local updated=0 uptodate=0 failed=0
    for f in "$tmpdir"/*; do
        [[ -f "$f" ]] || continue
        name=$(basename "$f")
        status=$(cut -d: -f2 "$f")
        case "$status" in
            updated)  echo -e "${CYAN}⬇${NC}  $name... ${GREEN}updated${NC}";  updated=$((updated + 1)) ;;
            uptodate) echo -e "${CYAN}⬇${NC}  $name... ${GREEN}up to date${NC}"; uptodate=$((uptodate + 1)) ;;
            failed)   echo -e "${CYAN}⬇${NC}  $name... ${RED}failed${NC}";    failed=$((failed + 1)) ;;
        esac
    done
    rm -rf "$tmpdir"
    div
    echo -e "  ${BOLD}Summary:${NC} ${GREEN}⬇ ${updated} updated${NC}, ${GREEN}✓ ${uptodate} up to date${NC}${failed:+, ${RED}✗ ${failed} failed${NC}}"
    div
}

cmd_list() {
    echo
    div
    echo -e "${BOLD}  ⬡  Repositories in ${BASE_DIR}${NC}"
    div
    local width=$(get_max_name_length "${REPOS[@]}")
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            status="${GREEN}cloned${NC}"
            icon="${GREEN}✓${NC}"
        else
            status="${YELLOW}not cloned${NC}"
            icon="${YELLOW}⊝${NC}"
        fi
        printf "  $icon  %-${width}s %b\n" "$name" "$status"
    done
    div
}

cmd_doctor() {
    build_pacman_cache
    echo
    div
    echo -e "${BOLD}  ⚙  Checking tools...${NC}"
    div

    local missing_required=()
    local missing_optional=()
    local current_cat=""
    local cat_tools=()
    local max_width=0

    print_category() {
        [[ ${#cat_tools[@]} -eq 0 ]] && return
        max_width=$(get_max_name_length "${cat_tools[@]}")
        local label=$(get_category_label "$current_cat")
        echo -e "${BOLD}$label:${NC}"
        for t in "${cat_tools[@]}"; do
            parse_tool_entry "$t"
            local name="$TOOL_NAME"
            local cmds="$TOOL_CMDS"
            local desc="$TOOL_DESC"
            local source_tag=""
            if [[ "$TOOL_CONTAINER" != "root" ]]; then
                source_tag=" [$TOOL_CONTAINER:$TOOL_PKG_MGR]"
            fi
            if [[ "$TOOL_TYPE" == "required" ]]; then
                if check_installed "$TOOL_PKG_MGR" "$name" "$cmds" "$TOOL_CONTAINER" "$TOOL_EXPORT"; then
                    if [[ "$TOOL_CONTAINER" != "root" ]] && is_from_host "$cmds"; then
                        printf "  ${GREEN}✓${NC}  %-${max_width}s ${YELLOW}(host)${NC}" "$name"
                    else
                        printf "  ${GREEN}✓${NC}  %-${max_width}s ${GREEN}found${NC}" "$name"
                    fi
                else
                    printf "  ${RED}✗${NC}  %-${max_width}s ${RED}not found${NC}" "$name"
                    missing_required+=("$name|$desc|$TOOL_CONTAINER:$TOOL_PKG_MGR")
                fi
            else
                if [[ -z "$cmds" && -z "$TOOL_PKG_MGR" ]]; then
                    printf "  ${YELLOW}?${NC}  %-${max_width}s ${YELLOW}skip${NC}" "$name"
                else
                    if check_installed "$TOOL_PKG_MGR" "$name" "$cmds" "$TOOL_CONTAINER" "$TOOL_EXPORT"; then
                        if [[ "$TOOL_CONTAINER" != "root" ]] && is_from_host "$cmds"; then
                            printf "  ${GREEN}✓${NC}  %-${max_width}s ${YELLOW}(host)${NC}" "$name"
                        else
                            printf "  ${GREEN}✓${NC}  %-${max_width}s ${GREEN}found${NC}" "$name"
                        fi
                    else
                        printf "  ${YELLOW}⚠${NC}  %-${max_width}s ${YELLOW}not found${NC}" "$name"
                        missing_optional+=("$name|$desc|$TOOL_CONTAINER:$TOOL_PKG_MGR")
                    fi
                fi
            fi
            if [[ -n "$desc" ]]; then
                echo -e " ${CYAN}($desc)${NC}${source_tag}"
            else
                echo -e "${source_tag}"
            fi
        done
        echo
        cat_tools=()
    }

    for tool in "${TOOLS[@]}"; do
        parse_tool_entry "$tool"
        if [[ "$TOOL_CATEGORY" != "$current_cat" ]]; then
            print_category
            current_cat="$TOOL_CATEGORY"
        fi
        cat_tools+=("$tool")
    done
    print_category

    echo
    div
    echo -e "${BOLD}  Summary${NC}"
    div

    echo -e "${BOLD}Missing Required:${NC}"
    if [[ ${#missing_required[@]} -eq 0 ]]; then
        echo -e "  ${GREEN}✓ All installed${NC}"
    else
        for tool in "${missing_required[@]}"; do
            IFS='|' read -r name desc source <<< "$tool"
            local tag=""
            [[ -n "$source" ]] && tag=" [$source]"
            if [[ -n "$desc" ]]; then
                echo -e "  ${RED}✗${NC} $name ${CYAN}($desc)${NC}${tag}"
            else
                echo -e "  ${RED}✗${NC} $name${tag}"
            fi
        done
    fi

    echo
    echo -e "${BOLD}Missing Optional:${NC}"
    if [[ ${#missing_optional[@]} -eq 0 ]]; then
        echo -e "  ${GREEN}✓ All installed${NC}"
    else
        for tool in "${missing_optional[@]}"; do
            IFS='|' read -r name desc source <<< "$tool"
            local tag=""
            [[ -n "$source" ]] && tag=" [$source]"
            if [[ -n "$desc" ]]; then
                echo -e "  ${YELLOW}⚠${NC} $name ${CYAN}($desc)${NC}${tag}"
            else
                echo -e "  ${YELLOW}⚠${NC} $name${tag}"
            fi
        done
    fi
    div
}

do_install_pkgs() {
    local all_pkgs=("$@")
    local aur_pkgs=()
    local pacman_pkgs=()
    local dbx_pkgs=()
    local dbx_containers=()
    local dbx_pkg_mgrs=()
    local dbx_cmds_list=()
    local dbx_export_list=()

    if [[ ${#all_pkgs[@]} -eq 0 ]]; then
        echo -e "${GREEN}No packages to install.${NC}"
        return
    fi

    for pkg in "${all_pkgs[@]}"; do
        local found_cmds=""
        for tool in "${TOOLS[@]}"; do
            parse_tool_entry "$tool"
            if [[ "$TOOL_NAME" == "$pkg" ]]; then
                found_cmds="$TOOL_CMDS"
                break
            fi
        done
        if [[ "$TOOL_CONTAINER" != "root" ]]; then
            dbx_pkgs+=("$pkg")
            dbx_containers+=("$TOOL_CONTAINER")
            dbx_pkg_mgrs+=("$TOOL_PKG_MGR")
            dbx_cmds_list+=("$found_cmds")
            dbx_export_list+=("$TOOL_EXPORT")
        elif [[ "$TOOL_PKG_MGR" == "aur" ]]; then
            aur_pkgs+=("$pkg")
        else
            pacman_pkgs+=("$pkg")
        fi
    done

    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        mapfile -t pacman_pkgs < <(printf '%s\n' "${pacman_pkgs[@]}" | sort -u)
        echo -e "${BOLD}Installing via pacman:${NC}"
        echo -e "  ${GREEN}${pacman_pkgs[*]}${NC}"
        sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
    fi
    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        mapfile -t aur_pkgs < <(printf '%s\n' "${aur_pkgs[@]}" | sort -u)
        if ! command -v paru >/dev/null 2>&1; then
            echo -e "${RED}Error: paru not found. Install paru first.${NC}"
        else
            echo -e "${BOLD}Installing via paru (AUR):${NC}"
            echo -e "  ${YELLOW}${aur_pkgs[*]}${NC}"
            paru -S --needed --noconfirm "${aur_pkgs[@]}"
        fi
    fi
    if [[ ${#dbx_pkgs[@]} -gt 0 ]]; then
        if ! check_distrobox_available; then
            echo -e "${RED}Error: distrobox not found. Install distrobox first.${NC}"
        else
            declare -A dbx_grouped
            for i in "${!dbx_pkgs[@]}"; do
                local key="${dbx_containers[$i]}:${dbx_pkg_mgrs[$i]}"
                dbx_grouped[$key]="${dbx_grouped[$key]} ${dbx_pkgs[$i]}|${dbx_cmds_list[$i]}|${dbx_export_list[$i]}"
            done
            for key in "${!dbx_grouped[@]}"; do
                local container="${key%%:*}"
                local pkg_mgr="${key#*:}"
                ensure_container "$container"
                local to_install=()
                local to_export_cmds=()
                local to_export_mode=()
                for entry in ${dbx_grouped[$key]}; do
                    IFS='|' read -r pkg cmds emode <<< "$entry"
                    to_install+=("$pkg")
                    to_export_cmds+=("$cmds")
                    to_export_mode+=("$emode")
                done
                if [[ ${#to_install[@]} -gt 0 ]]; then
                    dbx_install_packages "$container" "$pkg_mgr" "${to_install[@]}"
                    for i in "${!to_install[@]}"; do
                        do_dbx_export "$container" "${to_install[$i]}" "${to_export_cmds[$i]}" "${to_export_mode[$i]}"
                    done
                fi
            done
        fi
    fi
}

cmd_install_interactive() {
    local category="$1"
    local show_all="$2"

    local fzf_input=()
    local item_data=()

    for tool in "${TOOLS[@]}"; do
        parse_tool_entry "$tool"
        [[ -n "$category" && "$TOOL_CATEGORY" != "$category" ]] && continue
        [[ -z "$TOOL_PKG_MGR" ]] && continue

        local installed=0
        if check_installed "$TOOL_PKG_MGR" "$TOOL_NAME" "$TOOL_CMDS" "$TOOL_CONTAINER" "$TOOL_EXPORT"; then
            installed=1
        fi

        if [[ $installed -eq 1 && "$show_all" != "1" ]]; then
            continue
        fi

        local cat_label
        cat_label=$(get_category_label "$TOOL_CATEGORY")
        local target_label="${TOOL_CONTAINER}:${TOOL_PKG_MGR}"
        item_data+=("${installed}|${TOOL_NAME}|${target_label}")

        if [[ $installed -eq 1 ]]; then
            fzf_input+=("$(printf '\033[2m%-30s \033[0m %-20s %-16s %s' "${TOOL_NAME} ✓" "${target_label}" "${cat_label}" "${TOOL_DESC}")")
        else
            fzf_input+=("$(printf '%-30s %-20s %-16s %s' "${TOOL_NAME}" "${target_label}" "${cat_label}" "${TOOL_DESC}")")
        fi
    done

    if [[ ${#fzf_input[@]} -eq 0 ]]; then
        echo -e "${GREEN}All tools already installed!${NC}"
        return
    fi

    local selected
    selected=$(printf '%s\n' "${fzf_input[@]}" |
        fzf -m \
            --ansi \
            --height=~60% \
            --border=rounded \
            --prompt="Select packages > " \
            --bind='space:toggle,ctrl-a:select-all,ctrl-x:deselect-all,shift-tab:toggle,ctrl-u:half-page-up,ctrl-d:half-page-down' \
            --color='fg+:green:bold,pointer:green:bold' \
            --header=$'\e[1mSpace: toggle  Ctrl-A: select all  Ctrl-X: deselect all  Enter: install  Esc: cancel\e[0m' |
        sed 's/ .*//' | sed $'s/\x1b\\[[0-9;]*m//g')

    [[ -z "$selected" ]] && return

    local to_install=()
    for pkg in $selected; do
        local skip=0
        for item in "${item_data[@]}"; do
            IFS='|' read -r inst iname _source <<< "$item"
            if [[ "$iname" == "$pkg" && "$inst" == "1" ]]; then
                skip=1
                break
            fi
        done
        [[ $skip -eq 0 ]] && to_install+=("$pkg")
    done

    if [[ ${#to_install[@]} -eq 0 ]]; then
        echo -e "${GREEN}No new packages selected.${NC}"
        return
    fi

    echo
    div
    echo -e "${BOLD}  Packages to install:${NC} ${GREEN}${to_install[*]}${NC}"
    div
    do_install_pkgs "${to_install[@]}"
    div
}

cmd_install() {
    build_pacman_cache
    local target=""
    local interactive=0
    local show_all=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--interactive) interactive=1 ;;
            -a|--all) show_all=1 ;;
            --list|-l)
                echo
                div
                echo -e "${BOLD}  Available Categories${NC}"
                div
                for entry in "${CATEGORY_ALIASES[@]}"; do
                    IFS=: read -r alias name <<< "$entry"
                    printf "  ${GREEN}%-16s${NC} %s\n" "$alias" "$name"
                done
                div
                return
                ;;
            *) target="$1" ;;
        esac
        shift
    done

    if [[ -n "$target" ]]; then
        local resolved=""
        for entry in "${CATEGORY_ALIASES[@]}"; do
            IFS=: read -r alias _name <<< "$entry"
            if [[ "$target" == "$alias" ]]; then
                resolved="$alias"
                break
            fi
        done
        if [[ -z "$resolved" ]]; then
            echo -e "${RED}Error: Unknown category '$target'${NC}"
            echo -e "Run ${CYAN}menv install --list${NC} to see available categories"
            return 1
        fi
    fi

    if [[ $interactive -eq 1 ]]; then
        cmd_install_interactive "$target" "$show_all"
        return
    fi

    local pacman_pkgs=()
    local aur_pkgs=()
    local dbx_pkgs=()
    local dbx_containers=()
    local dbx_pkg_mgrs=()
    local dbx_cmds_list=()
    local dbx_export_list=()
    local current_cat=""
    local has_output=0

    echo
    div
    echo -e "${BOLD}  Installing Tools${NC}"
    div

    for tool in "${TOOLS[@]}"; do
        parse_tool_entry "$tool"

        if [[ -n "$target" && "$TOOL_CATEGORY" != "$target" ]]; then
            continue
        fi

        if [[ "$TOOL_CATEGORY" != "$current_cat" ]]; then
            [[ $has_output -eq 1 ]] && echo
            echo -e "${BOLD}$(get_category_label "$TOOL_CATEGORY"):${NC}"
            current_cat="$TOOL_CATEGORY"
            has_output=1
        fi

        if check_installed "$TOOL_PKG_MGR" "$TOOL_NAME" "$TOOL_CMDS" "$TOOL_CONTAINER" "$TOOL_EXPORT"; then
            echo -e "  ${GREEN}✓${NC} $TOOL_NAME (already installed)"
        elif [[ -z "$TOOL_PKG_MGR" ]]; then
            echo -e "  ${YELLOW}?${NC} $TOOL_NAME (no package source)${CYAN}($TOOL_DESC)${NC}"
        else
            if [[ "$TOOL_CONTAINER" != "root" ]]; then
                echo -e "  ${BLUE}+${NC} $TOOL_NAME [$TOOL_CONTAINER:$TOOL_PKG_MGR]"
                dbx_pkgs+=("$TOOL_NAME")
                dbx_containers+=("$TOOL_CONTAINER")
                dbx_pkg_mgrs+=("$TOOL_PKG_MGR")
                dbx_cmds_list+=("$TOOL_CMDS")
                dbx_export_list+=("$TOOL_EXPORT")
            elif [[ "$TOOL_PKG_MGR" == "aur" ]]; then
                echo -e "  ${YELLOW}+${NC} $TOOL_NAME [aur]"
                aur_pkgs+=("$TOOL_NAME")
            else
                echo -e "  ${GREEN}+${NC} $TOOL_NAME [pacman]"
                pacman_pkgs+=("$TOOL_NAME")
            fi
        fi
    done

    echo
    div
    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        mapfile -t pacman_pkgs < <(printf '%s\n' "${pacman_pkgs[@]}" | sort -u)
    fi
    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        mapfile -t aur_pkgs < <(printf '%s\n' "${aur_pkgs[@]}" | sort -u)
    fi

    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        echo -e "${BOLD}Installing via pacman:${NC}"
        echo -e "  ${GREEN}${pacman_pkgs[*]}${NC}"
        sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
    fi
    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        if ! command -v paru >/dev/null 2>&1; then
            echo -e "${RED}Error: paru not found. Install paru first.${NC}"
        else
            echo -e "${BOLD}Installing via paru (AUR):${NC}"
            echo -e "  ${YELLOW}${aur_pkgs[*]}${NC}"
            paru -S --needed --noconfirm "${aur_pkgs[@]}"
        fi
    fi
    if [[ ${#dbx_pkgs[@]} -gt 0 ]]; then
        if ! check_distrobox_available; then
            echo -e "${RED}Error: distrobox not found. Install distrobox first.${NC}"
        else
            declare -A dbx_grouped
            for i in "${!dbx_pkgs[@]}"; do
                local key="${dbx_containers[$i]}:${dbx_pkg_mgrs[$i]}"
                dbx_grouped[$key]="${dbx_grouped[$key]} ${dbx_pkgs[$i]}|${dbx_cmds_list[$i]}|${dbx_export_list[$i]}"
            done
            for key in "${!dbx_grouped[@]}"; do
                local container="${key%%:*}"
                local pkg_mgr="${key#*:}"
                ensure_container "$container"
                local to_install=()
                local to_export_cmds=()
                local to_export_mode=()
                for entry in ${dbx_grouped[$key]}; do
                    IFS='|' read -r pkg cmds emode <<< "$entry"
                    to_install+=("$pkg")
                    to_export_cmds+=("$cmds")
                    to_export_mode+=("$emode")
                done
                if [[ ${#to_install[@]} -gt 0 ]]; then
                    dbx_install_packages "$container" "$pkg_mgr" "${to_install[@]}"
                    for i in "${!to_install[@]}"; do
                        do_dbx_export "$container" "${to_install[$i]}" "${to_export_cmds[$i]}" "${to_export_mode[$i]}"
                    done
                fi
            done
        fi
    fi
    if [[ ${#pacman_pkgs[@]} -eq 0 && ${#aur_pkgs[@]} -eq 0 && ${#dbx_pkgs[@]} -eq 0 ]]; then
        echo -e "${GREEN}All tools already installed!${NC}"
    fi
    div
}

cmd_link() {
    echo
    div
    echo -e "${BOLD}  ⇲  Linking dotfiles...${NC}"
    div
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        link_script="$BASE_DIR/$name/link.sh"
        if [[ -x "$link_script" ]]; then
            echo -e "${CYAN}⟹${NC}  Linking $name"
            "$link_script"
        else
            echo -e "  ${YELLOW}⊝${NC}  $name link.sh not found or executable"
        fi
    done
    div
}

cmd_status() {
    build_pacman_cache

    local repo_total=${#REPOS[@]}
    local repo_cloned=0
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        [[ -d "$BASE_DIR/$name/.git" ]] && repo_cloned=$((repo_cloned + 1))
    done

    local tool_total=${#TOOLS[@]}
    local tool_installed=0
    local missing_required=()
    for tool in "${TOOLS[@]}"; do
        parse_tool_entry "$tool"
        if check_installed "$TOOL_PKG_MGR" "$TOOL_NAME" "$TOOL_CMDS" "$TOOL_CONTAINER" "$TOOL_EXPORT"; then
            tool_installed=$((tool_installed + 1))
        elif [[ "$TOOL_TYPE" == "required" ]]; then
            missing_required+=("$TOOL_NAME")
        fi
    done

    echo
    div
    echo -e "${BOLD}  Overview${NC}"
    div

    local repo_bar=$(progressbar $repo_cloned $repo_total 20)
    if [[ $repo_cloned -eq $repo_total ]]; then
        echo -e "  ${GREEN}✓${NC} Repos:  ${GREEN}${repo_bar}${NC}  ${repo_cloned}/${repo_total} cloned"
    else
        echo -e "  ${YELLOW}⚠${NC} Repos:  ${YELLOW}${repo_bar}${NC}  ${repo_cloned}/${repo_total} cloned"
    fi

    local tool_bar=$(progressbar $tool_installed $tool_total 20)
    echo -e "  ${CYAN}⬡${NC} Tools:  ${CYAN}${tool_bar}${NC}  ${tool_installed}/${tool_total} installed"

    if [[ ${#missing_required[@]} -eq 0 ]]; then
        echo -e "  ${GREEN}✓${NC} All required tools installed"
    else
        echo -e "  ${RED}✗${NC} ${#missing_required[@]} required tools missing: ${RED}${missing_required[*]}${NC}"
    fi

    div
}

cmd_protocol() {
    local new_protocol="$1"
    if [[ "$new_protocol" != "https" && "$new_protocol" != "ssh" ]]; then
        echo -e "${RED}Error:${NC} Protocol must be 'https' or 'ssh'"
        echo "Usage: menv protocol [https|ssh]"
        return 1
    fi

    echo
    echo -e "${BOLD}Switching protocol to ${CYAN}$new_protocol${NC}${BOLD}...${NC}"
    div

    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        base_url="${item#*:}"
        new_url=$(convert_url "$base_url" "$new_protocol")
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            echo -n -e "  ${CYAN}↻${NC}  Updating $name remote... "
            if git -C "$repo_path" remote set-url origin "$new_url" 2>/dev/null; then
                echo -e "${GREEN}done${NC}"
            else
                echo -e "${RED}failed${NC}"
            fi
        fi
    done
    div
}

cmd_run() {
    local target="$1"
    shift || true

    if [[ "$target" == "--list" || "$target" == "-l" || -z "$target" ]]; then
        echo
        div
        echo -e "${BOLD}  Available Scripts${NC}"
        div
        local max_len=0
        for entry in "${SCRIPTS[@]}"; do
            IFS=: read -r alias _ _ <<< "$entry"
            local len=${#alias}
            ((len > max_len)) && max_len=$len
        done
        for entry in "${SCRIPTS[@]}"; do
            IFS=: read -r alias filename desc <<< "$entry"
            printf "  ${GREEN}%-*s${NC} %s\n" "$max_len" "$alias" "$desc"
        done
        div
        return
    fi

    local resolved_file=""
    local resolved_desc=""
    for entry in "${SCRIPTS[@]}"; do
        IFS=: read -r alias filename desc <<< "$entry"
        if [[ "$target" == "$alias" ]]; then
            resolved_file="$filename"
            resolved_desc="$desc"
            break
        fi
    done

    if [[ -z "$resolved_file" ]]; then
        echo -e "${RED}Error: Unknown script '$target'${NC}"
        echo -e "Run ${CYAN}menv run --list${NC} to see available scripts"
        return 1
    fi

    local script_path="$SCRIPT_DIR/sh/$resolved_file"
    if [[ ! -f "$script_path" ]]; then
        echo -e "${RED}Error: Script file not found: $script_path${NC}"
        return 1
    fi

    echo
    div
    echo -e "${BOLD}  ▶  Running $resolved_desc${NC}"
    div
    bash "$script_path" "$@"
    local exit_code=$?
    div
    return $exit_code
}

cmd_box() {
    local action="${1:-list}"
    shift || true

    case "$action" in
        list|ls)
            echo
            div
            echo -e "${BOLD}  Distrobox Containers${NC}"
            div
            if check_distrobox_available; then
                distrobox-list
            else
                echo -e "  ${YELLOW}distrobox not installed${NC}"
            fi
            div
            ;;
        setup)
            echo
            div
            echo -e "${BOLD}  Setting up distrobox containers...${NC}"
            div
            for entry in "${DISTROBOX_CONTAINERS[@]}"; do
                IFS=: read -r name image home_dir <<< "$entry"
                if container_exists "$name"; then
                    echo -e "  ${GREEN}✓${NC} $name (exists)"
                else
                    if [[ -z "$home_dir" ]]; then
                        home_dir="$BASE_DIR/distrobox/$name"
                    fi
                    echo -ne "  ${GREEN}+${NC} Creating $name ($image)... "
                    if distrobox-create --name "$name" --image "$image" --home "$home_dir" --yes >/dev/null 2>&1; then
                        echo -e "${GREEN}done${NC}"
                    else
                        echo -e "${RED}failed${NC}"
                    fi
                fi
            done
            div
            ;;
        create)
            local name="$1"
            if [[ -z "$name" ]]; then
                echo -e "${RED}Usage: menv box create <name>${NC}"
                return 1
            fi
            ensure_container "$name"
            ;;
        enter)
            local name="$1"
            if [[ -z "$name" ]]; then
                echo -e "${RED}Usage: menv box enter <name>${NC}"
                return 1
            fi
            distrobox-enter --name "$name"
            ;;
        stop)
            local name="$1"
            if [[ -z "$name" ]]; then
                echo -e "${RED}Usage: menv box stop <name>${NC}"
                return 1
            fi
            distrobox-stop --name "$name"
            ;;
        rm|remove)
            local name="$1"
            if [[ -z "$name" ]]; then
                echo -e "${RED}Usage: menv box rm <name>${NC}"
                return 1
            fi
            distrobox-rm --name "$name" --force
            ;;
        upgrade)
            local name="$1"
            if [[ -z "$name" ]]; then
                distrobox-upgrade --all
            else
                distrobox-upgrade "$name"
            fi
            ;;
        *)
            echo -e "${RED}Unknown action: $action${NC}"
            echo "Usage: menv box [list|setup|create|enter|stop|rm|upgrade]"
            return 1
            ;;
    esac
}

show_help() {
    echo
    echo -e "${BOLD}menv${NC} - Development Environment Manager"
    echo
    echo -e "${CYAN}Usage:${NC}"
    echo "    menv <command>"
    echo
    echo -e "${CYAN}Commands:${NC}"
    echo -e "    ${GREEN}init${NC}      Clone all repositories"
    echo -e "    ${GREEN}pull${NC}     Pull all repositories (including menv itself)"
    echo -e "    ${GREEN}list${NC}     List all repositories"
    echo -e "    ${GREEN}link${NC}     Execute link.sh in all repositories"
    echo -e "    ${GREEN}doctor${NC}   Check required and optional tools"
    echo -e "    ${GREEN}status${NC}   Show quick overview (repos + tools)"
    echo -e "    ${GREEN}install${NC}  Install missing tools (pacman + AUR + distrobox)"
    echo -e "           ${DIM}-i${NC}  Interactive select (fzf)"
    echo -e "           ${DIM}-a${NC}  Show all (including installed)"
    echo -e "           ${DIM}<category>${NC}  Install specific category"
    echo -e "    ${GREEN}box${NC}       Manage distrobox containers"
    echo -e "           ${DIM}list${NC}              List containers"
    echo -e "           ${DIM}setup${NC}             Create all configured containers"
    echo -e "           ${DIM}enter <name>${NC}      Enter a container"
    echo -e "           ${DIM}stop <name>${NC}       Stop a container"
    echo -e "           ${DIM}rm <name>${NC}         Remove a container"
    echo -e "           ${DIM}upgrade [name]${NC}    Upgrade container(s)"
    echo -e "    ${GREEN}run${NC}       Run setup scripts from sh/ directory"
    echo -e "    ${GREEN}protocol${NC}  Switch clone protocol (https|ssh)"
    echo
    echo -e "${CYAN}Examples:${NC}"
    echo "    menv init"
    echo "    menv pull"
    echo "    menv list"
    echo "    menv link"
    echo "    menv status"
    echo "    menv doctor"
    echo "    menv install"
    echo "    menv install cli"
    echo "    menv install --list"
    echo "    menv install -i"
    echo "    menv install -i wayland"
    echo "    menv install -i -a"
    echo "    menv box setup"
    echo "    menv box enter arch"
    echo "    menv box upgrade"
    echo "    menv run"
    echo "    menv run paru"
    echo "    menv run swapfile 24"
    echo "    menv protocol ssh"
}

main() {
    cmd="$1"
    shift || true
    case "$cmd" in
        init)    cmd_init ;;
        pull)   cmd_pull ;;
        list)   cmd_list ;;
        link)   cmd_link ;;
        doctor) cmd_doctor ;;
        status) cmd_status ;;
        install) cmd_install "$@" ;;
        box)     cmd_box "$@" ;;
        run)     cmd_run "$@" ;;
        protocol) cmd_protocol "$@" ;;
        help|--help|-h) show_help ;;
        "")
            show_help
            ;;
        *)
            echo -e "${RED}Error:${NC} Unknown command: $cmd"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
