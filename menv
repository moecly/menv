#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_DIR="${MOECLY_DIR:-$HOME/.moecly_conf}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

div() {
    printf "${CYAN}%s${NC}\n" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

REPOS=(
    "tmux:https://github.com/moecly/tmux-config.git"
    "zsh:https://github.com/moecly/zsh-config.git"
    "nvim:https://github.com/moecly/nvim-config.git"
)

TOOLS=(
    "git:git"
    "lazygit:lazygit"
    "fd:fd fdfind"
    "rg:rg"
    "fzf:fzf"
    "zsh:zsh"
    "nvim:nvim"
    "tmux:tmux"
    "npm:npm"
    "unzip:unzip"
    "python3:python3"
    "pip3:pip3"
    "pipx:pipx"
)

check_base_dir() {
    if [[ ! -d "$BASE_DIR" ]]; then
        mkdir -p "$BASE_DIR"
    fi
}

cmd_init() {
    check_base_dir
    echo
    echo -e "${BOLD}Initializing repositories...${NC}"
    div
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        url="${item#*:}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path" ]]; then
            echo -e "  ${YELLOW}⊝${NC}  $name"
        else
            echo -n -e "  ${GREEN}⬢${NC}  Cloning $name... "
            if git clone "$url" "$repo_path" 2>/dev/null; then
                echo -e "${GREEN}done${NC}"
            else
                echo -e "${RED}failed${NC}"
            fi
        fi
    done
    div
}

cmd_pull() {
    echo
    div
    echo -e "${BOLD}  ⬇  Updating menv${NC}"
    if [[ -d "$SCRIPT_DIR/.git" ]]; then
        git -C "$SCRIPT_DIR" pull
    else
        echo -e "  ${YELLOW}⊝${NC}  menv is not a git repository"
    fi
    div

    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            echo -e "${CYAN}⬇${NC}  Pulling $name"
            git -C "$repo_path" pull
        fi
    done
    div
}

cmd_list() {
    echo
    div
    echo -e "${BOLD}  ⬡  Repositories in ${BASE_DIR}${NC}"
    div
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            status="${GREEN}cloned${NC}"
            icon="${GREEN}✓${NC}"
        else
            status="${YELLOW}not cloned${NC}"
            icon="${YELLOW}⊝${NC}"
        fi
        printf "  $icon  %-10s %b\n" "$name" "$status"
    done
    div
}

cmd_doctor() {
    echo
    div
    echo -e "${BOLD}  ⚙  Checking tools...${NC}"
    div
    for tool in "${TOOLS[@]}"; do
        name="${tool%%:*}"
        cmds="${tool#*:}"
        found=0
        for cmd in $cmds; do
            if command -v "$cmd" >/dev/null 2>&1; then
                found=1
                break
            fi
        done
        if [[ $found -eq 1 ]]; then
            printf "  ${GREEN}✓${NC}  %-8s ${GREEN}found${NC}\n" "$name"
        else
            printf "  ${RED}✗${NC}  %-8s ${RED}not found${NC}\n" "$name"
        fi
    done
    div
}

cmd_link() {
    echo
    div
    echo -e "${BOLD}  ⇲  Linking dotfiles...${NC}"
    div
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        link_script="$BASE_DIR/$name/link.sh"
        if [[ -x "$link_script" ]]; then
            echo -e "${CYAN}⟹${NC}  Linking $name"
            "$link_script"
        else
            echo -e "  ${YELLOW}⊝${NC}  $name link.sh not found or executable"
        fi
    done
    div
}

show_help() {
    cat <<EOF

  ${BOLD}menv${NC} - Development Environment Manager

${CYAN}Usage:${NC}
    menv <command>

${CYAN}Commands:${NC}
    ${GREEN}init${NC}    Clone all repositories
    ${GREEN}pull${NC}   Pull all repositories (including menv itself)
    ${GREEN}list${NC}   List all repositories
    ${GREEN}link${NC}   Execute link.sh in all repositories
    ${GREEN}doctor${NC} Check required tools

${CYAN}Examples:${NC}
    menv init
    menv pull
    menv list
    menv link
    menv doctor
EOF
}

main() {
    cmd="$1"
    shift || true
    case "$cmd" in
        init)    cmd_init ;;
        pull)   cmd_pull ;;
        list)   cmd_list ;;
        link)   cmd_link ;;
        doctor) cmd_doctor ;;
        help|--help|-h) show_help ;;
        "")
            show_help
            ;;
        *)
            echo -e "${RED}Error:${NC} Unknown command: $cmd"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
