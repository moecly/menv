    "pacman:wayland:optional:fuzzel:fuzzel:Wayland 应用启动器"
    "pacman:wayland:optional:kitty:kitty:GPU 加速终端"
    "pacman:wayland:optional:xwayland-satellite:xwayland-satellite:XWayland 兼容层"
    "aur:wayland:optional:wlogout:wlogout:Wayland 锁屏工具"
    "pacman:input:optional:fcitx5:fcitx5:输入法框架"
    "pacman:input:optional:fcitx5-qt::输入法框架 Qt 插件"
    "pacman:input:optional:fcitx5-gtk::输入法框架 GTK 插件"
    "pacman:input:optional:fcitx5-configtool:fcitx5-configtool:输入法框架配置工具"
