    "keyd:keyd:键盘重映射工具"
    "dms-shell-niri:dms:动态菜单"
    "alacritt-theme-git::Alacritty 主题"
    "keepassxc:keepassxc:密码管理器"
    "localsend-bin:localsend:局域网文件传输"
    "chromium:chromium:网页浏览器"
    "clash-verge-rev-bin:clash-verge:代理客户端"
    "yay:yay:AUR 包管理器"
