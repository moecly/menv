check_base_dir() {
    if [[ ! -d "$BASE_DIR" ]]; then
        mkdir -p "$BASE_DIR"
    fi
}

cmd_init() {
    check_base_dir
    echo
    echo -e "${BOLD}Initializing repositories...${NC}"
    div
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        url="${item#*:}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path" ]]; then
            echo -e "  ${YELLOW}⊝${NC}  $name"
        else
            echo -n -e "  ${GREEN}⬢${NC}  Cloning $name... "
            if git clone "$url" "$repo_path" 2>/dev/null; then
                echo -e "${GREEN}done${NC}"
            else
                echo -e "${RED}failed${NC}"
            fi
        fi
    done
    div
}

cmd_pull() {
    echo
    div
    echo -e "${BOLD}  ⬇  Updating menv${NC}"
    if [[ -d "$SCRIPT_DIR/.git" ]]; then
        git -C "$SCRIPT_DIR" pull
    else
        echo -e "  ${YELLOW}⊝${NC}  menv is not a git repository"
    fi
    div

    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            echo -e "${CYAN}⬇${NC}  Pulling $name"
            git -C "$repo_path" pull
        fi
    done
    div
}

cmd_list() {
    echo
    div
    echo -e "${BOLD}  ⬡  Repositories in ${BASE_DIR}${NC}"
    div
    local width=$(get_max_name_length "${REPOS[@]}")
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            status="${GREEN}cloned${NC}"
            icon="${GREEN}✓${NC}"
        else
            status="${YELLOW}not cloned${NC}"
            icon="${YELLOW}⊝${NC}"
        fi
        printf "  $icon  %-${width}s %b\n" "$name" "$status"
    done
    div
}

cmd_doctor() {
    echo
    div
    echo -e "${BOLD}  ⚙  Checking tools...${NC}"
    div

    local missing_required=()
    local missing_optional=()

    check_category() {
        local label="$1"
        shift
        local tools=("$@")
        local max_width=$(get_max_name_length "${tools[@]}")
        local is_optional=0
        if [[ "$label" == Optional:* ]]; then
            is_optional=1
        fi

        echo -e "${BOLD}$label:${NC}"
        for tool in "${tools[@]}"; do
            IFS=: read -r name cmds desc source <<< "$tool"
            local found=0
            if [[ -z "$cmds" ]]; then
                printf "  ${YELLOW}?${NC}  %-${max_width}s ${YELLOW}skip${NC}" "$name"
            else
                for cmd in $cmds; do
                    if command -v "$cmd" >/dev/null 2>&1; then
                        found=1
                        break
                    fi
                done
                if [[ $found -eq 1 ]]; then
                    printf "  ${GREEN}✓${NC}  %-${max_width}s ${GREEN}found${NC}" "$name"
                else
                    if [[ $is_optional -eq 1 ]]; then
                        printf "  ${YELLOW}⚠${NC}  %-${max_width}s ${YELLOW}not found${NC}" "$name"
                        missing_optional+=("$name:$desc:$source")
                    else
                        printf "  ${RED}✗${NC}  %-${max_width}s ${RED}not found${NC}" "$name"
                        missing_required+=("$name:$desc:$source")
                    fi
                fi
            fi
            if [[ -n "$desc" ]]; then
                echo -e " ${CYAN}($desc)${NC}"
            else
                echo
            fi
        done
        echo
    }

    check_category "Required: 基础工具" "${REQUIRED_TOOLS[@]}"
    check_category "Required: Shell/终端" "${REQUIRED_SHELL_TERMINAL[@]}"
    check_category "Required: 文件管理" "${REQUIRED_FILE_MANAGEMENT[@]}"
    check_category "Required: TUI 客户端" "${REQUIRED_TUI_CLIENTS[@]}"
    check_category "Optional: 包管理器/语言运行时" "${OPTIONAL_PACKAGE_MANAGERS[@]}"
    check_category "Optional: Wayland/桌面" "${OPTIONAL_WAYLAND_DESKTOP[@]}"
    check_category "Optional: 输入法/字体" "${OPTIONAL_INPUT_METHOD_FONTS[@]}"
    check_category "Optional: CLI 增强工具" "${OPTIONAL_CLI_ENHANCEMENTS[@]}"
    check_category "Optional: 网络/安全" "${OPTIONAL_NETWORK_SECURITY[@]}"
    check_category "Optional: 系统管理" "${OPTIONAL_SYSTEM_MANAGEMENT[@]}"
    check_category "Optional: 生产力/娱乐" "${OPTIONAL_PRODUCTIVITY_ENTERTAINMENT[@]}"
    check_category "Optional: 其他" "${OPTIONAL_OTHER[@]}"

    echo
    div
    echo -e "${BOLD}  Summary${NC}"
    div

    echo -e "${BOLD}Missing Required:${NC}"
    if [[ ${#missing_required[@]} -eq 0 ]]; then
        echo -e "  ${GREEN}✓ All installed${NC}"
    else
        for tool in "${missing_required[@]}"; do
            IFS=: read -r name desc source <<< "$tool"
            if [[ -n "$desc" ]]; then
                echo -e "  ${RED}✗${NC} $name ${CYAN}($desc)${NC}"
            else
                echo -e "  ${RED}✗${NC} $name"
            fi
        done
    fi

    echo
    echo -e "${BOLD}Missing Optional:${NC}"
    if [[ ${#missing_optional[@]} -eq 0 ]]; then
        echo -e "  ${GREEN}✓ All installed${NC}"
    else
        for tool in "${missing_optional[@]}"; do
            IFS=: read -r name desc source <<< "$tool"
            if [[ -n "$desc" ]]; then
                echo -e "  ${YELLOW}⚠${NC} $name ${CYAN}($desc)${NC}"
            else
                echo -e "  ${YELLOW}⚠${NC} $name"
            fi
        done
    fi
    div
}

cmd_install() {
    local target="$1"

    if [[ "$target" == "--list" || "$target" == "-l" ]]; then
        echo
        div
        echo -e "${BOLD}  Available Categories${NC}"
        div
        echo -e "  ${GREEN}base${NC}               基础工具"
        echo -e "  ${GREEN}shell${NC}              Shell/终端"
        echo -e "  ${GREEN}file${NC}               文件管理"
        echo -e "  ${GREEN}tui${NC}                TUI 客户端"
        echo -e "  ${GREEN}pkg${NC}                包管理器/语言运行时"
        echo -e "  ${GREEN}wayland${NC}            Wayland/桌面"
        echo -e "  ${GREEN}input${NC}              输入法/字体"
        echo -e "  ${GREEN}cli${NC}                CLI 增强工具"
        echo -e "  ${GREEN}net${NC}                网络/安全"
        echo -e "  ${GREEN}system${NC}             系统管理"
        echo -e "  ${GREEN}productivity${NC}       生产力/娱乐"
        echo -e "  ${GREEN}other${NC}              其他"
        div
        return
    fi

    local pacman_pkgs=()
    local aur_pkgs=()

    resolve_alias() {
        case "$1" in
            base) echo "基础工具:REQUIRED_TOOLS" ;;
            shell) echo "Shell/终端:REQUIRED_SHELL_TERMINAL" ;;
            file) echo "文件管理:REQUIRED_FILE_MANAGEMENT" ;;
            tui) echo "TUI 客户端:REQUIRED_TUI_CLIENTS" ;;
            pkg) echo "包管理器/语言运行时:OPTIONAL_PACKAGE_MANAGERS" ;;
            wayland) echo "Wayland/桌面:OPTIONAL_WAYLAND_DESKTOP" ;;
            input) echo "输入法/字体:OPTIONAL_INPUT_METHOD_FONTS" ;;
            cli) echo "CLI 增强工具:OPTIONAL_CLI_ENHANCEMENTS" ;;
            net) echo "网络/安全:OPTIONAL_NETWORK_SECURITY" ;;
            system) echo "系统管理:OPTIONAL_SYSTEM_MANAGEMENT" ;;
            productivity) echo "生产力/娱乐:OPTIONAL_PRODUCTIVITY_ENTERTAINMENT" ;;
            other) echo "其他:OPTIONAL_OTHER" ;;
            *) echo "" ;;
        esac
    }

    install_from_category() {
        local cat_entry="$1"
        IFS=: read -r label array_name <<< "$cat_entry"

        echo -e "${BOLD}$label:${NC}"
        local -n arr="$array_name"
        for tool in "${arr[@]}"; do
            IFS=: read -r name cmds desc source <<< "$tool"
            local installed=0
            if [[ -n "$cmds" ]]; then
                for cmd in $cmds; do
                    if command -v "$cmd" >/dev/null 2>&1; then
                        installed=1
                        break
                    fi
                done
            elif pacman -Qi "$name" >/dev/null 2>&1; then
                installed=1
            fi
            if [[ $installed -eq 1 ]]; then
                echo -e "  ${GREEN}✓${NC} $name (already installed)"
            else
                if [[ "$source" == "aur" ]]; then
                    echo -e "  ${YELLOW}+${NC} $name [aur]"
                    aur_pkgs+=("$name")
                else
                    echo -e "  ${GREEN}+${NC} $name [pacman]"
                    pacman_pkgs+=("$name")
                fi
            fi
        done
        echo
    }

    if [[ -n "$target" ]]; then
        local resolved=$(resolve_alias "$target")
        if [[ -z "$resolved" ]]; then
            echo -e "${RED}Error: Unknown category '$target'${NC}"
            echo -e "Run ${CYAN}menv install --list${NC} to see available categories"
            return 1
        fi
        install_from_category "$resolved"
    else
        install_from_category "基础工具:REQUIRED_TOOLS"
        install_from_category "Shell/终端:REQUIRED_SHELL_TERMINAL"
        install_from_category "文件管理:REQUIRED_FILE_MANAGEMENT"
        install_from_category "TUI 客户端:REQUIRED_TUI_CLIENTS"
        install_from_category "包管理器/语言运行时:OPTIONAL_PACKAGE_MANAGERS"
        install_from_category "Wayland/桌面:OPTIONAL_WAYLAND_DESKTOP"
        install_from_category "输入法/字体:OPTIONAL_INPUT_METHOD_FONTS"
        install_from_category "CLI 增强工具:OPTIONAL_CLI_ENHANCEMENTS"
        install_from_category "网络/安全:OPTIONAL_NETWORK_SECURITY"
        install_from_category "系统管理:OPTIONAL_SYSTEM_MANAGEMENT"
        install_from_category "生产力/娱乐:OPTIONAL_PRODUCTIVITY_ENTERTAINMENT"
        install_from_category "其他:OPTIONAL_OTHER"
    fi

    pacman_pkgs=($(printf '%s\n' "${pacman_pkgs[@]}" 2>/dev/null | sort -u))
    aur_pkgs=($(printf '%s\n' "${aur_pkgs[@]}" 2>/dev/null | sort -u))

    echo
    div
    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        echo -e "${BOLD}Installing via pacman:${NC}"
        echo -e "  ${GREEN}${pacman_pkgs[*]}${NC}"
        sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
    fi
    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        if ! command -v paru >/dev/null 2>&1; then
            echo -e "${RED}Error: paru not found. Install paru first.${NC}"
        else
            echo -e "${BOLD}Installing via paru (AUR):${NC}"
            echo -e "  ${YELLOW}${aur_pkgs[*]}${NC}"
            paru -S --needed --noconfirm "${aur_pkgs[@]}"
        fi
    fi
    if [[ ${#pacman_pkgs[@]} -eq 0 && ${#aur_pkgs[@]} -eq 0 ]]; then
        echo -e "${GREEN}All tools already installed!${NC}"
    fi
    div
}

cmd_link() {
    echo
    div
    echo -e "${BOLD}  ⇲  Linking dotfiles...${NC}"
    div
    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        link_script="$BASE_DIR/$name/link.sh"
        if [[ -x "$link_script" ]]; then
            echo -e "${CYAN}⟹${NC}  Linking $name"
            "$link_script"
        else
            echo -e "  ${YELLOW}⊝${NC}  $name link.sh not found or executable"
        fi
    done
    div
}

cmd_protocol() {
    local new_protocol="$1"
    if [[ "$new_protocol" != "https" && "$new_protocol" != "ssh" ]]; then
        echo -e "${RED}Error:${NC} Protocol must be 'https' or 'ssh'"
        echo "Usage: menv protocol [https|ssh]"
        return 1
    fi

    echo
    echo -e "${BOLD}Switching protocol to ${CYAN}$new_protocol${NC}${BOLD}...${NC}"
    div

    for item in "${REPOS[@]}"; do
        name="${item%%:*}"
        base_url="${item#*:}"
        new_url=$(convert_url "$base_url" "$new_protocol")
        repo_path="$BASE_DIR/$name"
        if [[ -d "$repo_path/.git" ]]; then
            echo -n -e "  ${CYAN}↻${NC}  Updating $name remote... "
            if git -C "$repo_path" remote set-url origin "$new_url" 2>/dev/null; then
                echo -e "${GREEN}done${NC}"
            else
                echo -e "${RED}failed${NC}"
            fi
        fi
    done
    div
}

show_help() {
    echo
    echo -e "${BOLD}menv${NC} - Development Environment Manager"
    echo
    echo -e "${CYAN}Usage:${NC}"
    echo "    menv <command>"
    echo
    echo -e "${CYAN}Commands:${NC}"
    echo -e "    ${GREEN}init${NC}      Clone all repositories"
    echo -e "    ${GREEN}pull${NC}     Pull all repositories (including menv itself)"
    echo -e "    ${GREEN}list${NC}     List all repositories"
    echo -e "    ${GREEN}link${NC}     Execute link.sh in all repositories"
    echo -e "    ${GREEN}doctor${NC}   Check required and optional tools"
    echo -e "    ${GREEN}install${NC}  Install missing tools (pacman + AUR)"
    echo -e "    ${GREEN}protocol${NC}  Switch clone protocol (https|ssh)"
    echo
    echo -e "${CYAN}Examples:${NC}"
    echo "    menv init"
    echo "    menv pull"
    echo "    menv list"
    echo "    menv link"
    echo "    menv doctor"
    echo "    menv install"
    echo "    menv install cli"
    echo "    menv install --list"
    echo "    menv protocol ssh"
}

main() {
    cmd="$1"
    shift || true
    case "$cmd" in
        init)    cmd_init ;;
        pull)   cmd_pull ;;
        list)   cmd_list ;;
        link)   cmd_link ;;
        doctor) cmd_doctor ;;
        install) cmd_install "$@" ;;
        protocol) cmd_protocol "$@" ;;
        help|--help|-h) show_help ;;
        "")
            show_help
            ;;
        *)
            echo -e "${RED}Error:${NC} Unknown command: $cmd"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
