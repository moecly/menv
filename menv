    "snapper:snapper:Btrfs 快照工具"
    "snap-pac::Pacman 钩子自动快照"
    "nodejs:nodejs node:JavaScript 运行时"
    "opencode:opencode:AI 编程助手"
    "niri:niri:Wayland 合成器"
    "fuzzel:fuzzel:Wayland 应用启动器"
    "kitty:kitty:GPU 加速终端"
    "ttf-0xproto-nerd::等宽字体"
